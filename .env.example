# Supabase project (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never exposed to the browser. Used by admin server actions.
SUPABASE_SERVICE_ROLE_KEY=

# Backoffice shared account
ADMIN_PASSWORD=
# Random secret used to sign the admin session cookie. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# Absolute URL of the site (used to build shareable card links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
